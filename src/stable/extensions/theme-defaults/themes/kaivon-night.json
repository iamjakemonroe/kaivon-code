	"semanticTokenColors": {
		"parameter": "#E4E5F4",
		"variable.readonly": "#E4E5F4",
		"function": "#6FC8FF",
		"method": "#6FC8FF",
		"class": "#FFD37A",
		"interface": "#FFD37A",
		"enum": "#FFD37A",
		"type": "#FFD37A",
		"namespace": "#FFD37A",
		"property": "#9CD6FF",
		"enumMember": "#FFB46B",
		"decorator": "#D0A8FF",
		"*.deprecated": {
			"strikethrough": true
		}
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#6D7196",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical.python",
				"keyword.operator.wordlike"
			],
			"settings": {
				"foreground": "#B9A8FF"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"punctuation.definition.string",
				"string.template",
				"meta.embedded.assembly"
			],
			"settings": {
				"foreground": "#7FE0B4"
			}
		},
		{
			"scope": [
				"string.regexp",
				"constant.character.escape",
				"constant.other.character-class.regexp"
			],
			"settings": {
				"foreground": "#FF9CCB"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.language.boolean",
				"constant.language.null",
				"support.constant",
				"constant.other.color"
			],
			"settings": {
				"foreground": "#FFB46B"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic",
				"entity.name.function.member",
				"variable.function"
			],
			"settings": {
				"foreground": "#6FC8FF"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"support.type",
				"entity.other.inherited-class",
				"entity.name.namespace",
				"storage.type.primitive",
				"storage.type.built-in"
			],
			"settings": {
				"foreground": "#FFD37A"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"meta.definition.variable",
				"variable.parameter"
			],
			"settings": {
				"foreground": "#E4E5F4"
			}
		},
		{
			"scope": [
				"variable.language",
				"variable.language.this",
				"variable.language.self",
				"variable.parameter.function.language.special"
			],
			"settings": {
				"foreground": "#D0A8FF",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property",
				"meta.object-literal.key",
				"support.type.property-name",
				"support.type.property-name.json",
				"entity.name.tag.yaml"
			],
			"settings": {
				"foreground": "#9CD6FF"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag",
				"meta.tag.sgml"
			],
			"settings": {
				"foreground": "#FF8FB0"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"entity.other.attribute-name.html"
			],
			"settings": {
				"foreground": "#9CD6FF"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation",
				"punctuation.separator",
				"punctuation.terminator",
				"meta.brace"
			],
			"settings": {
				"foreground": "#A2A5C4"
			}
		},
		{
			"scope": [
				"meta.decorator",
				"entity.name.function.decorator",
				"meta.annotation",
				"storage.type.annotation",
				"punctuation.decorator"
			],
			"settings": {
				"foreground": "#D0A8FF"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#FFFFFF",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#6FC8FF",
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#7FE0B4"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#6D7196",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.list punctuation.definition.list"
			],
			"settings": {
				"foreground": "#B9A8FF"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#7FE0B4"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#FF8FB0"
			}
		},
		{
			"scope": [
				"markup.changed"
			],
			"settings": {
				"foreground": "#FFB46B"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#FF6B8F"
			}
		}
	]
}